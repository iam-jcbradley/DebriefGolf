# Copy to .env and fill in real values for local development.
# .env is gitignored — never commit real secrets.

# --- Database ---
POSTGRES_USER=debrief
POSTGRES_PASSWORD=debrief
POSTGRES_DB=debrief_golf
DATABASE_URL=postgresql+psycopg://debrief:debrief@localhost:5432/debrief_golf

# --- Garmin Connect API (OAuth 2.0) ---
# See docs/PRD.md §4.1 — required for automatic round/activity sync.
# Get CLIENT_ID/SECRET by registering an app in the Garmin Developer Portal;
# AUTHORIZE_URL/TOKEN_URL come from that same registration — they're left
# blank rather than guessed (app/services/garmin_oauth.py refuses to build a
# request until these are set, rather than hitting a wrong-but-plausible URL).
# The callback hits the FastAPI backend directly (this app has no Next.js
# API routes — Next.js is frontend-only, FastAPI owns all backend logic).
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
GARMIN_REDIRECT_URI=http://localhost:8000/api/auth/garmin/callback
GARMIN_AUTHORIZE_URL=
GARMIN_TOKEN_URL=

# --- Mapbox (hole satellite imagery, dispersion overlays) ---
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- App ---
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
# Comma-separated origins the API accepts browser requests from (the web app's origin).
CORS_ORIGINS=http://localhost:3000
# Signs the Garmin OAuth `state` token (app/services/garmin_oauth.py) — MUST
# be a real random secret in any deployed environment, never the default.
SECRET_KEY=dev-insecure-secret-change-me
ENV=development
