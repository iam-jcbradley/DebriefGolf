# Copy to .env and fill in real values for local development.
# .env is gitignored — never commit real secrets.

# --- Database ---
POSTGRES_USER=debrief
POSTGRES_PASSWORD=debrief
POSTGRES_DB=debrief_golf
DATABASE_URL=postgresql+psycopg://debrief:debrief@localhost:5432/debrief_golf

# --- Garmin Connect API (OAuth 2.0) ---
# See docs/PRD.md §4.1 — required for automatic round/activity sync.
# Get CLIENT_ID/SECRET by registering an app in the Garmin Developer Portal;
# AUTHORIZE_URL/TOKEN_URL come from that same registration — they're left
# blank rather than guessed (app/services/garmin_oauth.py refuses to build a
# request until these are set, rather than hitting a wrong-but-plausible URL).
# The callback hits the FastAPI backend directly (this app has no Next.js
# API routes — Next.js is frontend-only, FastAPI owns all backend logic).
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
GARMIN_REDIRECT_URI=http://localhost:8000/api/auth/garmin/callback
GARMIN_AUTHORIZE_URL=
GARMIN_TOKEN_URL=

# --- Mapbox (hole satellite imagery, dispersion overlays) ---
# This gets bundled into client-side JS (NEXT_PUBLIC_*), so it's visible to
# anyone who views the deployed site's source — that's expected for a Mapbox
# "pk." token. To stop other people's page loads from billing your account,
# scope the token to your specific domains (e.g. localhost:3000, your prod
# domain) under URL restrictions in the Mapbox account dashboard.
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- App ---
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
# Comma-separated origins the API accepts browser requests from (the web app's origin).
CORS_ORIGINS=http://localhost:3000
# Signs the login session cookie (app/core/security.py) and the Garmin OAuth
# `state` token, and derives the encryption key for stored Garmin tokens.
# MUST be a real random secret in any deployed environment: anyone who knows
# it can mint a session for any account. The API refuses to start with this
# example value unless ENV=development. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-insecure-secret-change-me

# --- Login sessions ---
# Cookie name and lifetime. The cookie is HttpOnly + SameSite=Lax, and
# Secure whenever ENV is not "development" (a Secure cookie is never sent
# over plain http://localhost, so local dev would break).
SESSION_COOKIE_NAME=debrief_session
SESSION_TTL_DAYS=30
ENV=development

# --- Outbound email (password reset) ---
# SMTP_HOST blank means "not configured": app/services/email.py logs the
# message instead of sending it, since there's no SMTP server reachable
# from this sandbox to verify against. Set all of these for a real
# deployment — there's no separate "email enabled" flag, SMTP_HOST being
# set already means it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Debrief Golf <no-reply@debriefgolf.app>
SMTP_USE_TLS=true
