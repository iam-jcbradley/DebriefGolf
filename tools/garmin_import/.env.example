# Copy to .env and fill in. This file stays on your machine — see
# garmin_client.py's module docstring for why the Garmin credentials below
# never touch the DebriefGolf backend.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# A real DebriefGolf account, used by `upload` and `import-scorecard` to log
# in (POST /api/auth/login) and get a session cookie — identity there comes
# from the cookie, not a user-id parameter, since Phase 10.
DEBRIEFGOLF_EMAIL=
DEBRIEFGOLF_PASSWORD=
