# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# `next dev`'s agent-rules generator is disabled (next.config.ts), but
# gitignore these too in case a contributor's Next version doesn't honor
# that flag — the generated CLAUDE.md is just `@AGENTS.md` and would shadow
# this repo's real root CLAUDE.md if ever committed.
/AGENTS.md
/CLAUDE.md

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
